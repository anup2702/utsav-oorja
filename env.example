# Firebase Configuration
# Copy this file to .env and fill in your actual Firebase credentials
# Get these values from your Firebase Console > Project Settings > General

FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional: Google Gemini AI API Key (for AI chatbot features)
REACT_APP_GEMINI_API_KEY=your-gemini-api-key

# Optional: Google Translate API Key (for translation features)
REACT_APP_GOOGLE_TRANSLATE_API_KEY=your-translate-api-key

# Optional: Google Analytics Tracking ID
REACT_APP_GA_TRACKING_ID=your-ga-tracking-id
